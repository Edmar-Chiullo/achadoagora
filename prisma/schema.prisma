generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

enum SourceType {
  MANUAL
  IMPORTED
}

enum ImportStatus {
  PENDING
  PROCESSING
  SUCCESS
  PARTIAL
  FAILED
}

model Platform {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  shortLabel String?
  badgeKey   String?
  status     Status    @default(ACTIVE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]

  @@map("platforms")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  description   String?
  image         String?
  price         Decimal?   @db.Decimal(10, 2)
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  platformId    String
  platform      Platform   @relation(fields: [platformId], references: [id], onDelete: Restrict)
  affiliateLink String
  status        Status     @default(ACTIVE)
  featured      Boolean    @default(false)
  sourceType    SourceType @default(MANUAL)
  sourceUrl     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  clicks        Click[]

  @@index([status])
  @@index([categoryId])
  @@index([platformId])
  @@index([sourceType])
  @@map("products")
}

model Click {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform    String
  source      String?
  userAgent   String?
  ipHash      String?
  country     String?
  region      String?
  city        String?
  referrer    String?
  pageUrl     String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  locale      String?
  browser     String?
  os          String?
  deviceType  String?
  deviceBrand String?
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([platform])
  @@index([source])
  @@index([createdAt])
  @@map("clicks")
}

model Visit {
  id          String    @id @default(cuid())
  path        String
  referrer    String?
  source      String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  userAgent   String?
  ipHash      String?
  vidHash     String?
  country     String?
  region      String?
  city        String?
  browser     String?
  os          String?
  deviceType  String?
  deviceBrand String?
  locale      String?
  duration    Int?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([source])
  @@map("visits")
}

model ProductImportLog {
  id               String       @id @default(cuid())
  sourceUrl        String
  platform         String?
  status           ImportStatus @default(PENDING)
  errorCode        String?
  errorMessage     String?
  extractionMethod String?
  confidence       Float?
  result           Json?
  startedAt        DateTime     @default(now())
  completedAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("product_import_logs")
}

model ImportCache {
  id        String   @id @default(cuid())
  urlHash   String   @unique
  url       String
  result    Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([urlHash])
  @@index([expiresAt])
  @@map("import_cache")
}
